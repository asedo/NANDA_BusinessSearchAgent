# BusinessSearchAgent — environment template
#
#   cp .env.example .env      # then fill in the values you need
#
# .env is gitignored. This template is committed; never put real values here.
# Real environment variables take precedence over this file, so production and
# CI can run without a .env existing at all.
#
# NOTHING BELOW IS REQUIRED FOR THE CURRENT PIPELINE.
# OpenStreetMap, Overpass, and Nominatim are all keyless. You can run
# `python naics.py` and `python ingest_osm.py` with no .env file whatsoever.

# ---------------------------------------------------------------- secrets

# Needed only for stage 3 (extracting menus/hours from business websites).
# Not yet implemented. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Reserved for publishing an AgentFacts document to the NANDA Index.
# Not yet implemented; shape may change.
NANDA_REGISTRY_TOKEN=

# ------------------------------------------------- NANDA agent identity
# Non-secret, but deployment-specific. agentfacts.py emits obvious
# placeholders until these are set, and warns that the document is not
# registrable as-is.

# Namespaced handle, e.g. @asedo:business-search
# NANDA_HANDLE=

# DID for this agent. Must be a real, resolvable DID before registration.
# NANDA_AGENT_DID=

# DID of the owning person or organisation.
# NANDA_OWNER_DID=

# Public HTTPS endpoint where the agent answers queries.
# NANDA_ENDPOINT=

# --------------------------------------------------------------- settings
# Non-secret. Safe to commit real values for these if you ever want to.

# Where the SQLite database lives.
# BSA_DB_PATH=./businesses.db

# Optional contact appended to the User-Agent sent to OSM services.
# OSM etiquette appreciates a way to reach you if a query misbehaves.
# Note this becomes visible to those services — use a role address, not personal.
# BSA_CONTACT=ops@example.org

# Pin a single Overpass endpoint instead of the built-in mirror fallback list.
# BSA_OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter

# Model used for stage 3 extraction.
# ANTHROPIC_MODEL=claude-opus-4-8
